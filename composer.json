    "require": {
        "php": ">=8.5",
        "gizmocraft/zendframework1-exception": "^2.0.0",
        "gizmocraft/zendframework1-loader": "^2.0.0",
        "gizmocraft/zendframework1-registry": "^2.0.0",
        "gizmocraft/zendframework1-controller": "^2.0.0",
        "gizmocraft/zendframework1-application": "^2.0.0",
        "gizmocraft/zendframework1-db": "^2.0.0",
        "gizmocraft/zendframework1-dom": "^2.0.0",
        "gizmocraft/zendframework1-filter": "^2.0.0",
        "gizmocraft/zendframework1-layout": "^2.0.0",
        "gizmocraft/zendframework1-session": "^3.0.0",
        "phpunit/phpunit": "^10.5.0",
        "sebastian/comparator": "^5.0.1"
    },
    "autoload": {
        "psr-0": {
            "Zend_Test_": "src/"
        }
    },
    "autoload-dev": {
        "psr-0": {
            "Zend_": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "2.1.33",
        "friendsofphp/php-cs-fixer": "3.92.5",
        "gizmocraft/zendframework1-controller-action-helper-json": "^1.0.5",
        "gizmocraft/zendframework1-dojo": "^1.0.5",
        "maglnet/composer-require-checker": "^3.0.0",
        "phpro/grumphp-shim": "^2.0.0"
    },
    "archive": {
        "exclude": [
            "/tests"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "test-with-coverage": "phpunit --coverage-clover=clover.xml",
        "phpstan": "phpstan analyze -c phpstan.neon --no-progress --ansi --memory-limit=768M",
        "style-check": "php-cs-fixer fix --dry-run -vv"
    },
    "suggest": {
        "ext-dom": "Required for the DomQuery constraint"
    },
    "config": {
        "allow-plugins": {
            "phpro/grumphp-shim": true
        }
    }
}
